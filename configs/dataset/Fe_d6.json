{
  "system": {
    "name": "Fe_d6",
    "element": "Fe",
    "n_electrons_3d": 6
  },

  "paths": {
    "repository_root": "../..",

    "spec_directory": "../../quanty/runs/Fe_d6/spec",

    "quanty_results_csv": "../../quanty/runs/Fe_d6/metadata/quanty_results_Fe_d6.csv",

    "output_directory": "../../data/processed/Fe_d6",

    "prepared_dataset_npz": "../../data/processed/Fe_d6/Fe_d6_dataset.npz",

    "accepted_metadata_csv": "../../data/processed/Fe_d6/Fe_d6_accepted.csv",

    "split_output_directory": "../../data/splits/Fe_d6",

    "split_indices_npz": "../../data/splits/Fe_d6/Fe_d6_split_indices.npz",

    "split_csv": "../../data/splits/Fe_d6/Fe_d6_split.csv",

    "preprocess_output_directory": "../../data/preprocessed/Fe_d6",

    "preprocessed_dataset_npz": "../../data/preprocessed/Fe_d6/Fe_d6_preprocessed.npz",

    "scalers_npz": "../../data/preprocessed/Fe_d6/Fe_d6_scalers.npz",

    "audit_output_directory": "../../results/audit/Fe_d6"
  },

  "spectrum": {
    "xas_right_suffix": "_r.spec",

    "xas_left_suffix": "_l.spec",

    "xmcd_suffix": "_cd.spec",

    "skip_header": 4,

    "energy_column": 0,

    "value_column": 2,

    "require_equal_length": true,

    "require_same_energy_grid": true,

    "energy_rtol": 1e-10,

    "energy_atol": 1e-12
  },

  "columns": {
    "prefix": "Prefix",

    "sz": "Sz",

    "lz": "Lz",

    "b_ext_t": "B_ext_T"
  },

  "external_magnetic_field": {
    "enabled": true,

    "magnitude_t": 2.0,

    "direction": [
      0.0,
      0.0,
      1.0
    ],

    "tolerance_t": 1e-9
  },

  "exclusion": {
    "exclude_both_moments_zero": false,

    "zero_tolerance": 1e-6
  },

  "split": {
    "train_ratio": 0.70,

    "validation_ratio": 0.15,

    "test_ratio": 0.15,

    "random_seed": 1234
  },

  "preprocessing": {
    "input_mode": "channel_wise_feature_standardization",

    "standardize_inputs": true,

    "standardize_targets": true,

    "fit_statistics_on": "training_only",

    "epsilon": 1e-6,

    "nonfinite_policy": "error"
  },

  "audit": {
    "parameter_columns": [
      "TEN_DQ",
      "SlaterScale",
      "SOC_2p",
      "SOC_3d",
      "H_ex",
      "B_ext_T"
    ],

    "parameter_round_decimals": 12,

    "spectrum_round_decimals": 12,

    "label_tolerance": 1e-12
  }
}